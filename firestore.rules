rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow users to search, view profiles, and register/update their profile
    match /users/{userId} {
      allow read, write: if true;
    }

    // Chats collection: Real-time conversations (direct & group)
    match /chats/{chatId} {
      allow read, write: if true;

      // Messages subcollection: Real-time chat messages
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Group Requests collection: Users submit requests to create groups, Admin approves
    match /groupRequests/{requestId} {
      allow read, write: if true;
    }

    // Password Requests collection: Users request password changes, Admin sets new password
    match /passwordRequests/{requestId} {
      allow read, write: if true;
    }
  }
}


