{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing unique personal chat code, display name, permissions, and avatar settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "normalizedName": { "type": "string" },
        "chatCode": { "type": "string" },
        "passwordHash": { "type": "string" },
        "avatarColor": { "type": "string" },
        "avatarIcon": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastSeen": { "type": "number" },
        "bio": { "type": "string" },
        "isBanned": { "type": "boolean" },
        "messagingDisabled": { "type": "boolean" },
        "voiceDisabled": { "type": "boolean" },
        "photosDisabled": { "type": "boolean" }
      },
      "required": ["uid", "name", "chatCode", "avatarColor", "avatarIcon", "createdAt"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "Chat conversation linked by unique chat codes and user IDs, supporting direct and group chats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "groupName": { "type": "string" },
        "groupDescription": { "type": "string" },
        "groupAvatar": { "type": "string" },
        "adminUid": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "participants": { "type": "object" },
        "lastMessage": { "type": "object" },
        "unreadCounts": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "participantIds", "participants", "unreadCounts", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhotoURL": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaDuration": { "type": "number" },
        "timestamp": { "type": "number" },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "reactions": { "type": "object" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "senderId", "senderName", "timestamp"]
    },
    "GroupRequest": {
      "title": "GroupRequest",
      "description": "Request submitted by user to create a new group chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestedBy": { "type": "string" },
        "requesterName": { "type": "string" },
        "groupName": { "type": "string" },
        "description": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "requestedBy", "requesterName", "groupName", "status", "createdAt"]
    },
    "PasswordRequest": {
      "title": "PasswordRequest",
      "description": "Request submitted by user to reset/change their account password",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userChatCode": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "userName", "userChatCode", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents accessible for search and connection"
    },
    "/chats/{chatId}": {
      "schema": "ChatConversation",
      "description": "Conversations between connected users or groups"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time messages sent within a conversation"
    },
    "/groupRequests/{requestId}": {
      "schema": "GroupRequest",
      "description": "Group creation requests submitted by users for admin approval"
    },
    "/passwordRequests/{requestId}": {
      "schema": "PasswordRequest",
      "description": "Password reset requests submitted by users for admin action"
    }
  }
}
